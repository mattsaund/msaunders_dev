/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# CSS and JS revalidate on every load. Their URLs carry a content hash (see
# stamp_assets in tools/build_pages.py) so they are cheap 304s in practice, but
# revalidating means a hand edit that skips the stamper can never leave anyone
# on a stale stylesheet. This site is 45KB of CSS+JS; correctness wins.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/files/*
  Cache-Control: public, max-age=86400
