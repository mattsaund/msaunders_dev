/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# CSS and JS revalidate on every load. Their URLs carry a content hash (see
# stamp_assets in tools/build_pages.py) so they are cheap 304s in practice, but
# revalidating means a hand edit that skips the stamper can never leave anyone
# on a stale stylesheet. This site is 45KB of CSS+JS; correctness wins.
/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/*
  Cache-Control: public, max-age=0, must-revalidate

# The Crucible page's own CSS and JS. They live under /crucible/, so the /css/*
# and /js/* rules above do not reach them, but their URLs are stamped by the
# same builder, so they get the same revalidate treatment.
/crucible/css/*
  Cache-Control: public, max-age=0, must-revalidate

/crucible/js/*
  Cache-Control: public, max-age=0, must-revalidate

# The tiny page's own CSS. Same arrangement as Crucible's: outside the reach of
# the /css/* rule, stamped by the same builder, so it revalidates the same way.
/tiny/css/*
  Cache-Control: public, max-age=0, must-revalidate

# tiny running in the page: the script, the vendored WASI shim, the wasm, the
# project it opens and its font. The script's URL is stamped; the wasm and the
# project are fetched under the hashes in manifest.json. All of it revalidates.
/tiny/app/*
  Cache-Control: public, max-age=0, must-revalidate

# The cosmos.js tool, copied in from its own repo. Its URLs carry no content
# hash, so revalidate rather than risk serving a stale build after a re-sync.
/cosmos/*
  Cache-Control: public, max-age=0, must-revalidate

# PDFs keep their public URLs when they are replaced, so a day's max-age left
# visitors on the old resume. Revalidating makes an update show up on the next
# load; the resume link on the home page is also stamped with its hash.
/files/*
  Cache-Control: public, max-age=0, must-revalidate
